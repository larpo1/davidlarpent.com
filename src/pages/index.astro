---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostListItem from '../components/PostListItem.astro';
import HomeInputRail from '../components/HomeInputRail.astro';
import { getThemes, sourceTagsUnion, themesForSource } from '../lib/themes';

const isDev = import.meta.env.DEV;

// Posts (output tab)
const allPosts = await getCollection('posts');
const posts = isDev
  ? allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  : allPosts
      .filter(post => !post.data.draft)
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Sources (input tab) — all sources, no notes filter, sorted by publication date desc
const allSources = await getCollection('sources');
const sources = (isDev ? allSources : allSources.filter(s => !s.data.archived))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// Themes — for the left rail
const themes = await getThemes();
themes.sort((a, b) => a.data.title.localeCompare(b.data.title));

interface SourceItem {
  slug: string;
  title: string;
  author: string;
  date: Date;
  tags: string[];
  themes: string[];
}

const sourceItems: SourceItem[] = sources.map(source => ({
  slug: source.slug,
  title: source.data.title,
  author: source.data.author,
  date: source.data.date,
  tags: sourceTagsUnion(source),
  themes: themesForSource(source.slug, themes, source).map(t => t.slug),
}));

// Tag frequency map for rail ordering (freq desc, then alpha)
const tagCounts = new Map<string, number>();
for (const item of sourceItems) {
  for (const t of item.tags) {
    tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
  }
}
const tagList = [...tagCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .map(([tag, count]) => ({ tag, count }));

const themeList = themes.map(t => ({ slug: t.slug, title: t.data.title }));
const themeTitleBySlug = Object.fromEntries(themeList.map(t => [t.slug, t.title]));

// JSON-LD WebSite Schema
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "David Larpent",
  "description": "Notes on philosophy, AI, cognitive science, and more.",
  "url": "https://davidlarpent.com",
  "author": {
    "@type": "Person",
    "name": "David Larpent",
    "url": "https://davidlarpent.com/about"
  },
  "inLanguage": "en"
};
---

<Base title="David Larpent" keywords={["AI", "philosophy", "cognitive science", "product strategy", "essays"]} hideThemesNav={true}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />

  <h1 class="sr-only">David Larpent — Notes on AI, Philosophy, and Product</h1>

  <div class="tab-navigation">
    <button
      class="tab-button"
      data-tab="output"
      aria-pressed="true"
    >
      Output
    </button>
    <button
      class="tab-button"
      data-tab="input"
      aria-pressed="false"
    >
      Input
    </button>
    <div class="tab-underline" aria-hidden="true"></div>
  </div>

  <ul class="post-list" data-tab-panel="output">
    {posts.map(post => (
      <PostListItem
        slug={post.slug}
        title={post.data.title}
        date={post.data.date}
        description={post.data.description}
        tags={post.data.tags}
        draft={post.data.draft}
        category={post.data.category || 'work'}
      />
    ))}
  </ul>

  <div class="input-panel" data-tab-panel="input" style="display: none;">
    <HomeInputRail themes={themeList} tags={tagList} />

    <div class="input-sources-column">
      <div class="input-active-filter" id="input-active-filter" hidden>
        <span class="input-active-filter-label" id="input-active-filter-label"></span>
        <a class="input-active-filter-link" id="input-active-filter-link" href="#" hidden>→ view full theme</a>
        <button class="input-active-filter-clear" id="input-active-filter-clear" type="button" aria-label="Clear filter">&times;</button>
      </div>
      <ul class="input-source-list">
        {sourceItems.map(item => (
          <li
            class="input-source-item"
            data-slug={item.slug}
            data-tags={JSON.stringify(item.tags)}
            data-themes={JSON.stringify(item.themes)}
          >
            <a href={`/sources/${item.slug}`} class="input-source-title">{item.title}</a>
            <p class="input-source-meta">
              <span>{item.author}</span>
              <span> &middot; </span>
              <span>{item.date.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {isDev && (
    <div class="drafts-toggle">
      <label class="toggle-pill">
        <input type="checkbox" id="show-drafts" checked />
        <span class="toggle-slider"></span>
        <span class="toggle-text">Drafts</span>
      </label>
    </div>
  )}
</Base>

<script is:inline define:vars={{ themeTitleBySlug }}>
  // Tab Navigation
  var tabButtons = document.querySelectorAll('.tab-button');
  var tabUnderline = document.querySelector('.tab-underline');
  var tabPanels = document.querySelectorAll('[data-tab-panel]');
  var draftsToggle = document.querySelector('.drafts-toggle');

  // Map old tab names to new ones for backward compatibility
  var tabMap = { 'work': 'output', 'not-work': 'output' };

  function setActiveTab(targetTab, isInitial) {
    targetTab = tabMap[targetTab] || targetTab;
    if (targetTab !== 'output' && targetTab !== 'input') targetTab = 'output';

    tabButtons.forEach(function(button) {
      var isActive = button.dataset.tab === targetTab;
      button.setAttribute('aria-pressed', isActive.toString());
    });

    var activeButton = document.querySelector('[data-tab="' + targetTab + '"]');
    if (activeButton && tabUnderline) {
      var buttonRect = activeButton.getBoundingClientRect();
      var containerRect = activeButton.parentElement.getBoundingClientRect();
      var offsetLeft = buttonRect.left - containerRect.left;

      if (isInitial) {
        tabUnderline.style.transition = 'none';
      }
      tabUnderline.style.transform = 'translateX(' + offsetLeft + 'px)';
      tabUnderline.style.width = buttonRect.width + 'px';
      if (isInitial) {
        tabUnderline.offsetWidth;
        tabUnderline.style.transition = '';
      }
    }

    tabPanels.forEach(function(panel) {
      if (panel.getAttribute('data-tab-panel') === targetTab) {
        panel.style.display = '';
        var items = panel.querySelectorAll('.post-list-item, .input-source-item');
        items.forEach(function(item, i) {
          item.classList.remove('fade-in');
          item.offsetWidth;
          item.style.animationDelay = (i * 40) + 'ms';
          item.classList.add('fade-in');
        });
      } else {
        panel.style.display = 'none';
      }
    });

    if (draftsToggle) {
      draftsToggle.style.display = targetTab === 'output' ? '' : 'none';
    }

    var url = new URL(window.location);
    url.searchParams.set('tab', targetTab);
    if (isInitial) {
      history.replaceState({}, '', url);
    } else {
      history.pushState({}, '', url);
    }
  }

  tabButtons.forEach(function(button) {
    button.addEventListener('click', function() {
      setActiveTab(button.dataset.tab, false);
    });
  });

  var urlParams = new URLSearchParams(window.location.search);
  var initialTab = urlParams.get('tab') || 'output';
  setActiveTab(initialTab, true);

  window.addEventListener('popstate', function() {
    var params = new URLSearchParams(window.location.search);
    var tab = params.get('tab') || 'output';
    setActiveTab(tab, false);
  });

  // --- Source filtering by theme or tag (mutually exclusive, single active filter) ---
  var sourceItems = document.querySelectorAll('.input-source-item');
  var railButtons = document.querySelectorAll('.input-rail-btn');
  var activeFilterBar = document.getElementById('input-active-filter');
  var activeFilterLabel = document.getElementById('input-active-filter-label');
  var activeFilterLink = document.getElementById('input-active-filter-link');
  var activeFilterClear = document.getElementById('input-active-filter-clear');

  function applyFilter(type, value, pushHistory) {
    railButtons.forEach(function(btn) {
      var isActive = type !== null
        && btn.dataset.filterType === type
        && btn.dataset.filterValue === value;
      btn.classList.toggle('active', isActive);
    });

    var visibleIndex = 0;
    sourceItems.forEach(function(item) {
      var show = true;
      if (type === 'theme') {
        var themes = JSON.parse(item.dataset.themes || '[]');
        show = themes.indexOf(value) !== -1;
      } else if (type === 'tag') {
        var tags = JSON.parse(item.dataset.tags || '[]');
        show = tags.indexOf(value) !== -1;
      }
      item.style.display = show ? '' : 'none';
      if (show) {
        item.classList.remove('fade-in');
        item.offsetWidth;
        item.style.animationDelay = (visibleIndex * 30) + 'ms';
        item.classList.add('fade-in');
        visibleIndex++;
      }
    });

    if (activeFilterBar) {
      if (type === null) {
        activeFilterBar.hidden = true;
      } else {
        activeFilterBar.hidden = false;
        if (type === 'theme') {
          var title = themeTitleBySlug[value] || value;
          activeFilterLabel.textContent = 'Theme: ' + title;
          if (activeFilterLink) {
            activeFilterLink.hidden = false;
            activeFilterLink.href = '/themes/' + value;
          }
        } else {
          activeFilterLabel.textContent = 'Tag: #' + value;
          if (activeFilterLink) activeFilterLink.hidden = true;
        }
      }
    }

    var url = new URL(window.location);
    url.searchParams.delete('theme');
    url.searchParams.delete('tag');
    if (type === 'theme') url.searchParams.set('theme', value);
    else if (type === 'tag') url.searchParams.set('tag', value);
    if (pushHistory) {
      history.pushState({}, '', url);
    } else {
      history.replaceState({}, '', url);
    }
  }

  railButtons.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var alreadyActive = btn.classList.contains('active');
      if (alreadyActive) {
        applyFilter(null, null, true);
      } else {
        applyFilter(btn.dataset.filterType, btn.dataset.filterValue, true);
      }
    });
  });

  if (activeFilterClear) {
    activeFilterClear.addEventListener('click', function() {
      applyFilter(null, null, true);
    });
  }

  // Initialise filter from URL (theme takes precedence if both set)
  var themeParam = urlParams.get('theme');
  var tagParam = urlParams.get('tag');
  if (themeParam) {
    applyFilter('theme', themeParam, false);
  } else if (tagParam) {
    applyFilter('tag', tagParam, false);
  }
</script>

{isDev && (
  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const checkbox = document.getElementById('show-drafts');
      const draftPosts = document.querySelectorAll('[data-draft="true"]');

      checkbox?.addEventListener('change', (e) => {
        const showDrafts = e.target.checked;
        draftPosts.forEach(post => {
          post.style.display = showDrafts ? '' : 'none';
        });
      });
    });
  </script>
)}

<style>
  .drafts-toggle {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 100;
    opacity: 0.7;
    transition: opacity 0.2s;
  }

  .drafts-toggle:hover {
    opacity: 1;
  }

  .toggle-pill {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--color-code-bg);
    border: 1px solid var(--color-border);
    border-radius: 2rem;
    cursor: pointer;
    transition: border-color 0.2s;
  }

  .toggle-pill:hover {
    border-color: var(--color-link);
  }

  .toggle-pill input[type="checkbox"] {
    display: none;
  }

  .toggle-slider {
    position: relative;
    width: 2rem;
    height: 1rem;
    background: var(--color-border);
    border-radius: 1rem;
    transition: background 0.2s;
  }

  .toggle-slider::after {
    content: '';
    position: absolute;
    top: 0.125rem;
    left: 0.125rem;
    width: 0.75rem;
    height: 0.75rem;
    background: var(--color-background);
    border-radius: 50%;
    transition: transform 0.2s;
  }

  .toggle-pill input:checked + .toggle-slider {
    background: #6ba4ff;
  }

  .toggle-pill input:checked + .toggle-slider::after {
    transform: translateX(1rem);
  }

  .toggle-text {
    font-size: 0.75rem;
    color: var(--color-text-light);
    user-select: none;
  }
</style>
